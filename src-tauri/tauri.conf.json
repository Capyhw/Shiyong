{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "拾用",
  "version": "0.1.3",
  "identifier": "top.captain-space.shiyong",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "拾用",
        "width": 1120,
        "height": 800,
        "minWidth": 760,
        "minHeight": 580,
        "center": true
      },
      {
        "label": "launcher",
        "title": "拾用 · 主菜单",
        "url": "index.html?view=launcher",
        "width": 640,
        "height": 420,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: http://localhost:* http://127.0.0.1:* http://[::1]:* data:; connect-src ipc: http://ipc.localhost https: http://localhost:* http://127.0.0.1:* http://[::1]:*; object-src 'none'; frame-src 'none'; base-uri 'self'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' https: http: data:; connect-src ipc: http: https: ws:; object-src 'none'; frame-src 'none'; base-uri 'self'",
      "capabilities": ["host", "app-update"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM4NzMzQUQwODhGMjc2MDMKUldRRGR2S0kwRHB6eURGaUI1WVNVTlFnUmthZGJFMjZUa1V5TUc4Njd5bjhGQkxaMDU2WFA2QjAK",
      "endpoints": [
        "https://github.com/Capyhw/Shiyong/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
